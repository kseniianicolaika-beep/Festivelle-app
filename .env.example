# Neon (written automatically by `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_FUNCTION_CALENDAR_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# App
NEON_AUTH_COOKIE_SECRET=          # openssl rand -base64 32
APP_URL=                          # https://your-domain (used in emailed links)
APP_HOSTS=                        # comma-separated hosts of the app itself (not couples' domains)

# Optional: AI designer (any OpenAI-compatible endpoint). Neon AI Gateway vars win if present.
# NEON_AI_GATEWAY_BASE_URL= / NEON_AI_GATEWAY_TOKEN=   (needs a paid Neon plan)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Optional: email invitations (Resend)
RESEND_API_KEY=
EMAIL_FROM="Anya & Rohan <invites@yourdomain.com>"

# Optional: couples' custom domains via the Vercel API
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
