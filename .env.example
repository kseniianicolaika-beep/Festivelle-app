# Neon (written automatically by `neon deploy` / `neon env pull`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_FUNCTION_CALENDAR_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# App
NEON_AUTH_COOKIE_SECRET=          # openssl rand -base64 32
APP_URL=                          # https://your-domain (used in emailed links)
APP_HOSTS=                        # comma-separated hosts of the app itself (not couples' domains)

# AI — OpenRouter powers every AI feature (conversation, invitation wording, story, design choices)
OPENROUTER_API_KEY=
# Optional: a different FREE model first (must end in :free). Paid models are ignored by the code.
OPENROUTER_MODEL=

# Extra admins (optional). akshay@lyvena.xyz is a permanent owner in src/lib/admin.ts.
ADMIN_EMAILS=

# Optional: email invitations (Resend)
RESEND_API_KEY=
EMAIL_FROM="Anya & Rohan <invites@yourdomain.com>"

# Optional: couples' custom domains via the Vercel API
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
